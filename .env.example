# Gmail account with 2-Step Verification enabled
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-account@gmail.com
PORT=3000
EXPIRY_CHECK_INTERVAL_MINUTES=60

# Role-based sign-in accounts. Set a unique strong password for each enabled role.
ADMIN_NAME=Administrator
ADMIN_EMAIL=abc@admin.com
ADMIN_PASSWORD=123456
MANAGER_NAME=Inventory Manager
MANAGER_EMAIL=abc@manager.com
MANAGER_PASSWORD=123456
STAFF_NAME=Inventory Staff
STAFF_EMAIL=abc@staff.com
STAFF_PASSWORD=123456
